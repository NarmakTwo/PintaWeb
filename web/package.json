{
  "name": "pinta-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "asc as/pixels.ts -o src/wasm/pixels.wasm --runtime stub --optimize --initialMemory 16 --maximumMemory 4096 --noAssert",
    "dev": "npm run wasm && vite --host 127.0.0.1",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run build && playwright test"
  },
  "dependencies": {
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "assemblyscript": "^0.27.35",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}